# ==============================================================================
# LibreChat – environment variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# --- General ---
# URL that your ingress proxy exposes LibreChat on (no trailing slash).
DOMAIN_CLIENT=https://chat.example.com

# A strong random string used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# A strong random string for JWT refresh tokens.
JWT_REFRESH_SECRET=CHANGE_ME

# --- Meilisearch ---
# Master key for Meilisearch. Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=CHANGE_ME

# --- AI Provider API keys ---
# Add secrets here for any providers configured in librechat.yaml.
# Reference them in librechat.yaml with e.g. apiKey: "${OPENAI_API_KEY}"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# --- Session token lifetimes ---
SESSION_EXPIRY=1000*60*60*24*7
REFRESH_TOKEN_EXPIRY=1000*60*60*24*30
