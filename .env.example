# ==============================================================================
# LibreChat – environment variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# --- General ---
# Domain used for the LibreChat frontend (no trailing slash).
DOMAIN_CLIENT=https://your.domain.com

# A strong random string used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# A strong random string for JWT refresh tokens.
JWT_REFRESH_SECRET=CHANGE_ME

# --- Meilisearch ---
# Master key for Meilisearch – must match between the api and meilisearch services.
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=CHANGE_ME

# --- AI Provider API keys ---
# Add the keys for the providers you want to use.
# See: https://www.librechat.ai/docs/configuration/librechat_yaml/ai_endpoints
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_KEY=
# AZURE_OPENAI_KEY=

# --- Registration & security ---
# Set to 'true' to prevent new users from registering (recommended for private use).
ALLOW_REGISTRATION=false

# Comma-separated list of email addresses allowed to register when registration is restricted.
# ALLOWED_EMAIL=alice@example.com,bob@example.com

# Session cookie security – should be 'true' when serving over HTTPS.
SESSION_EXPIRY=1000*60*60*24*7
REFRESH_TOKEN_EXPIRY=1000*60*60*24*30
